{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Denkeez Phase 1 PoC の最小権限セット。プロジェクトファイルの読み書きとファイルダイアログのみ許可する (Plan §3 / R-07)。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file"
  ]
}
