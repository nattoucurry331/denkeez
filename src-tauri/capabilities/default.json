{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Denkeez β版の権限セット (Plan §3 / R-07)。プロジェクトファイル(JSON)読み書き、PDF バイナリ読込/書込、ファイルダイアログ、確認ダイアログ、close-requested 用の window 操作、自動更新プラグイン (Phase 2-F2) を許可。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-destroy",
    "core:window:allow-close",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "updater:default"
  ]
}
